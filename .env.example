# Copy to .env and change every value before running anywhere but your own machine.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# Long random string used to sign session cookies, e.g. output of: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Password for the "admin" account created on first start. Leave empty to generate one
# (printed in the api container logs).
SEED_ADMIN_PASSWORD=

# true = load fake demo records on first start; false = empty system (use before importing legacy data).
SEED_DEMO_DATA=true

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

WEB_PORT=8200
DB_PORT=3307

# Optional: TransPro database to import from (see README), e.g.
# LEGACY_DATABASE_URL=mysql://root@host.docker.internal:3306/carrental
LEGACY_DATABASE_URL=
